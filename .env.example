# --- Required for live audio ---
ASSEMBLYAI_API_KEY=

# --- Required for the LLM compliance judge + room agent ---
# Without this, Second Chair runs on the deterministic rule engine only.
ANTHROPIC_API_KEY=

# --- Optional: spoken whisper/room audio. Without it, channels are text-only. ---
ELEVENLABS_API_KEY=
ELEVENLABS_WHISPER_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_ROOM_VOICE_ID=AZnzlk1XvdvUeBnXmlld

# --- Models ---
# Latency lever: the judge runs on every finalized turn against a <1s budget.
# claude-opus-5 (default) is the most accurate; claude-sonnet-5 / claude-haiku-4-5
# trade accuracy for speed if you are missing the budget.
SC_JUDGE_MODEL=claude-opus-5
SC_ROOM_MODEL=claude-opus-5
SC_JUDGE_EFFORT=low

# --- Behaviour ---
SC_SOURCE=simulated          # simulated | assemblyai
SC_MAX_SPEAKERS=3
SC_SILENCE_NUDGE_SECONDS=90
SC_WHISPER_LATENCY_BUDGET_MS=1000
