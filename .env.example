# ============================================================================
#  Transcription  (required for live microphone input)
# ============================================================================
ASSEMBLYAI_API_KEY=

# ============================================================================
#  LLM  - powers the tier-2 compliance judge and the room agent
#  Three providers, tried in this order. Any one of them is enough.
#  Run `python check_llm.py` to see what your keys can actually reach.
# ============================================================================

# 1. Groq Cloud (default). Fast, capable free tier, full tool-calling support.
#    https://console.groq.com/keys
GROQ_API_KEY=

# 2. AssemblyAI LLM Gateway - the same key as transcription, so one credential
#    runs the whole product. Claude models there need a *paid* AssemblyAI
#    account; an unbilled key reaches only qwen3.5-4b-32k-fast.

# 3. Anthropic directly. Native structured outputs and the `effort` lever.
ANTHROPIC_API_KEY=

SC_LLM_BACKEND=auto          # auto | groq | gateway | anthropic | off
SC_LLM_REGION=us             # us | eu  (AssemblyAI gateway only)

# --- Models, per provider ---------------------------------------------------
# The judge is detached from the whisper budget, so it takes the stronger
# model; the room agent is heard aloud, so it takes the faster one.
SC_GROQ_JUDGE_MODEL=openai/gpt-oss-120b
SC_GROQ_ROOM_MODEL=openai/gpt-oss-20b

# Set to claude-opus-5 once your AssemblyAI account has Claude entitlements.
SC_GATEWAY_MODEL=qwen3.5-4b-32k-fast

SC_JUDGE_MODEL=claude-opus-5     # anthropic backend only
SC_ROOM_MODEL=claude-opus-5      # anthropic backend only
SC_JUDGE_EFFORT=low              # anthropic backend only

# ============================================================================
#  Voice  (optional - the browser speaks if this is unset)
# ============================================================================
ELEVENLABS_API_KEY=
ELEVENLABS_WHISPER_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_ROOM_VOICE_ID=AZnzlk1XvdvUeBnXmlld

# ============================================================================
#  Behaviour
# ============================================================================
SC_SOURCE=simulated              # simulated | assemblyai
SC_MAX_SPEAKERS=3
SC_SILENCE_NUDGE_SECONDS=90
SC_WHISPER_LATENCY_BUDGET_MS=1000
